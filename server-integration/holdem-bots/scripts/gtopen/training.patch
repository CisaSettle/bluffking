+    /// Initialize only the current action probabilities for offline training.
+    /// Old-game regrets and average strategy never enter the coupled-deck model.
+    pub fn initialize_shark_training(&mut self, seed: &Self) {
+        assert_eq!(self.iteration, 0);
+        assert_eq!(self.nodes.len(), seed.nodes.len());
+        assert!(!seed.has_overrides());
+        // Exclusive access to this fresh solver; no traversal is running.
+        let regrets = unsafe { self.regrets.slice_mut() };
+        for (index, node) in self.nodes.iter().enumerate() {
+            if node.actions.is_empty() { continue; }
+            let strategy = seed.average_strategy(index);
+            assert_eq!(node.data_off, seed.nodes[index].data_off);
+            assert_eq!(strategy.len(), node.actions.len() * NUM_CLASSES);
+            for (j, frequency) in strategy.into_iter().enumerate() {
+                regrets[node.data_off + j] = 0.1 * frequency;
+            }
+        }
+    }
+
+
+    /// Set one candidate average on a fresh tree. A matched public path
+    /// must have the same actor. Folds, checks, calls and jams retain their
+    /// meaning, while ordinary raises require the same BB amount. Unmapped
+    /// nodes retain the solver's uniform default. No seat or action is locked.
+    pub fn project_shark_average(&mut self, seed: &Self) {
+        assert_eq!(self.iteration, 0);
+        assert!(!self.has_overrides() && !seed.has_overrides());
+        assert_eq!(self.n, seed.n);
+        assert_eq!(self.multiway_equity_model(), seed.multiway_equity_model());
+        // Exclusive access to this new solver. No traversal runs during initialization.
+        let sums = unsafe { self.strat_sum.slice_mut() };
+        let mut paths = vec![(0, 0)];
+        while let Some((target_index, source_index)) = paths.pop() {
+            let target = &self.nodes[target_index];
+            let source = &seed.nodes[source_index];
+            if target.actions.is_empty() || source.actions.is_empty() || target.actor != source.actor {
+                continue;
+            }
+            let probabilities = seed.average_strategy(source_index);
+            for (index, action) in target.actions.iter().enumerate() {
+                let matches = |other: &PAction| action.kind == other.kind
+                    && (action.kind != "raise" || action.to == other.to);
+                if let Some(source_action) = source.actions.iter().position(matches) {
+                    let dest = target.data_off + index * NUM_CLASSES;
+                    let from = source_action * NUM_CLASSES;
+                    sums[dest..dest + NUM_CLASSES].copy_from_slice(&probabilities[from..from + NUM_CLASSES]);
+                    paths.push((self.child(target_index, index), seed.child(source_index, source_action)));
+                }
+            }
+        }
+        // One candidate average installed; loading this snapshot recomputes its
+        // leaf values. The exporter measures full BR in the unpatched target game.
+        self.iteration = 1;
+    }
